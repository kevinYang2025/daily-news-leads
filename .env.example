# Gemini API Key（Google AI Studio 获取，免费额度可用）
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# 运行口径（北京时间）
NEWS_TZ=Asia/Shanghai
NEWS_RUN_HOUR=10
NEWS_WINDOW_HOURS=24

# 采集调优
GDELT_MAX_RECORDS=150
MAX_ARTICLES_PER_CATEGORY=120
LLM_BATCH_SIZE=12

# 国内热榜补充，留空则跳过
HOT_API_BASE=https://api-hot.imsyy.top
